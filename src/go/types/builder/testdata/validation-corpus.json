  "cases": [
    {
      "name": "the fixture"
    },
    {
      "name": "zero zoom",
      "set": [
        {
          "path": [
            "viewport",
            "zoom"
          ],
          "value": 0
        }
      ],
      "error": "viewport.zoom"
    },
    {
      "name": "zero grid size",
