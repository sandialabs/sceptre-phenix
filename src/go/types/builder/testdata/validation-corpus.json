        {
          "path": [
            "nodes",
            0,
            "size"
          ],
          "value": {
            "width": 0,
            "height": 10
          }
        }
      ],
      "error": "nodes[0].size"
    },
    {
      "name": "document ID that is not a UUID",
      "set": [
        {
          "path": [
            "id"
          ],
