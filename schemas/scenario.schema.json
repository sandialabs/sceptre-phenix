{
  "$id": "https://raw.githubusercontent.com/sandialabs/sceptre-phenix/main/schemas/scenario.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A phenix Scenario config file (apiVersion phenix.sandia.gov/v2), checked as `phenix config create` checks it. Generated by src/go/tools/schema-export from the embedded OpenAPI schemas; do not edit.",
  "properties": {
    "apiVersion": {
      "const": "phenix.sandia.gov/v2"
    },
    "kind": {
      "const": "Scenario"
    },
    "metadata": {
      "description": "Name and optional metadata for the configuration resource.",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "String-valued metadata associated with the configuration resource.",
          "examples": [
            {
              "owner": "range-team"
            }
          ],
          "properties": {
            "builder-doc": {
              "additionalProperties": false,
              "description": "The Builder document that the topology references.",
              "minProperties": 1,
              "properties": {
                "digest": {
                  "description": "Digest of the Builder document.",
                  "examples": [
                    "sha256:aa"
                  ],
                  "title": "Digest",
                  "type": "string"
                },
                "id": {
                  "description": "Identifier of the Builder document.",
                  "examples": [
                    "0f1e2d"
                  ],
                  "title": "ID",
                  "type": "string"
                },
                "path": {
                  "description": "Path of the Builder document file.",
                  "examples": [
                    "/phenix/topologies/site/builder.yaml"
                  ],
                  "title": "Path",
                  "type": "string"
                }
              },
              "title": "Builder Document",
              "type": "object"
            }
          },
          "title": "Annotations",
          "type": "object"
        },
        "created": {
          "description": "RFC 3339 time at which phenix created the configuration resource.",
          "examples": [
            "2026-01-01T00:00:00Z"
          ],
          "readOnly": true,
          "title": "Created",
          "type": "string"
        },
        "name": {
          "description": "Unique name of the configuration resource.",
          "examples": [
            "example-topology"
          ],
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_@.-]*$",
          "title": "Name",
          "type": "string"
        },
        "updated": {
          "description": "RFC 3339 time at which phenix last updated the configuration resource.",
          "examples": [
            "2026-01-02T00:00:00Z"
          ],
          "readOnly": true,
          "title": "Updated",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "spec": {
      "$ref": "defs.schema.json#/$defs/Scenario",
      "description": "Kind-specific configuration fields.",
      "examples": [
        {}
      ],
      "title": "Specification",
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "phenix Scenario config",
  "type": "object"
}
