{
  "$id": "https://raw.githubusercontent.com/sandialabs/sceptre-phenix/main/schemas/scenario.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A phenix Scenario config file (apiVersion phenix.sandia.gov/v2), checked as `phenix config create` checks it. Generated by src/go/tools/schema-export from the embedded OpenAPI schemas; do not edit.",
  "properties": {
    "apiVersion": {
      "const": "phenix.sandia.gov/v2"
    },
    "kind": {
      "const": "Scenario"
    },
    "metadata": {
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "properties": {
            "builder-doc": {
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "digest": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              },
              "type": "object"
            }
          },
          "type": "object"
        },
        "created": {
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_@.-]*$",
          "type": "string"
        },
        "updated": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "spec": {
      "$ref": "defs.schema.json#/$defs/Scenario",
      "type": "object"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "title": "phenix Scenario config",
  "type": "object"
}
