{
  "$defs": {
    "Experiment": {
      "properties": {
        "baseDir": {
          "examples": [
            "/phenix/topologies/example-topo"
          ],
          "type": "string"
        },
        "experimentName": {
          "examples": [
            "example-exp"
          ],
          "readOnly": true,
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/experiment_scenario"
        },
        "schedule": {
          "additionalProperties": {
            "type": "string"
          },
          "examples": [
            {
              "ADServer": "compute1"
            }
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "topology": {
          "$ref": "#/$defs/Topology"
        },
        "vlans": {
          "properties": {
            "aliases": {
              "additionalProperties": {
                "type": "integer"
              },
              "examples": [
                {
                  "MGMT": 200
                }
              ],
              "type": [
                "object",
                "null"
              ]
            },
            "max": {
              "type": "integer"
            },
            "min": {
              "type": "integer"
            }
          },
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "topology"
      ],
      "type": "object"
    },
    "Image": {
      "properties": {
        "compress": {
          "default": false,
          "examples": [
            false
          ],
          "type": "boolean"
        },
        "deb_append": {
          "examples": [
            "--components=main,restricted"
          ],
          "type": "string"
        },
        "format": {
          "examples": [
            "qcow2"
          ],
          "type": "string"
        },
        "mirror": {
          "examples": [
            "http://us.archive.ubuntu.com/ubuntu/"
          ],
          "type": "string"
        },
        "overlays": {
          "examples": [
            [
              "/phenix/vmdb/overlays/example-overlay"
            ]
          ],
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "packages": {
          "examples": [
            [
              "isc-dhcp-client",
              "openssh-server"
            ]
          ],
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "ramdisk": {
          "default": false,
          "examples": [
            false
          ],
          "type": "boolean"
        },
        "release": {
          "examples": [
            "focal"
          ],
          "type": "string"
        },
        "script_order": {
          "examples": [
            [
              "POSTBUILD_APT_CLEANUP"
            ]
          ],
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "scripts": {
          "additionalProperties": {
            "type": "string"
          },
          "examples": [
            {
              "POSTBUILD_APT_CLEANUP": "apt clean || apt-get clean || echo \"unable to clean apt cache\"\n"
            }
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "size": {
          "examples": [
            "10G"
          ],
          "type": "string"
        },
        "variant": {
          "examples": [
            "minbase"
          ],
          "type": "string"
        }
      },
      "required": [
        "format",
        "mirror",
        "release",
        "size",
        "variant"
      ],
      "type": "object"
    },
    "Role": {
      "properties": {
        "policies": {
          "examples": [
            [
              {
                "resourceNames": [
                  "*"
                ],
                "resources": [
                  "experiments",
                  "experiments/*"
                ],
                "verbs": [
                  "list",
                  "get"
                ]
              }
            ]
          ],
          "items": {
            "properties": {
              "resourceNames": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "resources": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "verbs": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "roleName": {
          "examples": [
            "Example Role"
          ],
          "type": "string"
        }
      },
      "required": [
        "policies",
        "roleName"
      ],
      "type": "object"
    },
    "Scenario": {
      "properties": {
        "apps": {
          "items": {
            "properties": {
              "assetDir": {
                "examples": [
                  "/phenix/topologies/example-topo/assets"
                ],
                "type": "string"
              },
              "disabled": {
                "default": false,
                "examples": [
                  false
                ],
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "hosts": {
                "items": {
                  "properties": {
                    "hostname": {
                      "examples": [
                        "example-host"
                      ],
                      "type": "string"
                    },
                    "metadata": {
                      "additionalProperties": true,
                      "examples": [
                        {
                          "setting0": true,
                          "setting1": 42,
                          "setting2": "universe key"
                        }
                      ],
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "hostname"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "metadata": {
                "additionalProperties": true,
                "examples": [
                  {
                    "setting0": true,
                    "setting1": 42,
                    "setting2": "universe key"
                  }
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "name": {
                "examples": [
                  "example-app"
                ],
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "apps"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "Topology": {
      "properties": {
        "nodes": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/minimega_node"
              },
              {
                "$ref": "#/$defs/external_node"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "type": "object"
    },
    "User": {
      "properties": {
        "first_name": {
          "examples": [
            "John"
          ],
          "type": "string"
        },
        "last_name": {
          "examples": [
            "Doe"
          ],
          "type": "string"
        },
        "password": {
          "examples": [
            "\u003cencrypted password\u003e"
          ],
          "readOnly": true,
          "type": "string"
        },
        "rbac": {
          "allOf": [
            {
              "$ref": "#/$defs/Role"
            }
          ],
          "readOnly": true
        },
        "username": {
          "examples": [
            "johndoe@example.com"
          ],
          "type": "string"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "username"
      ],
      "type": "object"
    },
    "dhcp_iface": {
      "allOf": [
        {
          "$ref": "#/$defs/iface"
        },
        {
          "$ref": "#/$defs/iface_rulesets"
        }
      ],
      "properties": {
        "proto": {
          "default": "dhcp",
          "description": "How the interface is addressed: dhcp to ask a DHCP server, or manual to bring it up with no address.",
          "enum": [
            "dhcp",
            "manual"
          ],
          "examples": [
            "dhcp"
          ],
          "type": "string"
        },
        "type": {
          "default": "ethernet",
          "description": "Kind of interface: ethernet.",
          "enum": [
            "ethernet"
          ],
          "examples": [
            "ethernet"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "proto"
      ],
      "type": "object"
    },
    "experiment_scenario": {
      "properties": {
        "apps": {
          "items": {
            "properties": {
              "assetDir": {
                "examples": [
                  "/phenix/topologies/example-topo/assets"
                ],
                "type": "string"
              },
              "disabled": {
                "default": false,
                "examples": [
                  false
                ],
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "hosts": {
                "items": {
                  "properties": {
                    "hostname": {
                      "examples": [
                        "example-host"
                      ],
                      "type": "string"
                    },
                    "metadata": {
                      "additionalProperties": true,
                      "examples": [
                        {
                          "setting0": true,
                          "setting1": 42,
                          "setting2": "universe key"
                        }
                      ],
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "hostname"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "metadata": {
                "additionalProperties": true,
                "examples": [
                  {
                    "setting0": true,
                    "setting1": 42,
                    "setting2": "universe key"
                  }
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "name": {
                "examples": [
                  "example-app"
                ],
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "apps"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "external_node": {
      "properties": {
        "external": {
          "description": "Marks a device phenix does not deploy, such as hardware in the loop. It stays in the topology for State of Health and apps.",
          "type": "boolean"
        },
        "general": {
          "properties": {
            "description": {
              "description": "Free-text notes about the device.",
              "examples": [
                "Active Directory Server"
              ],
              "type": "string"
            },
            "hostname": {
              "description": "Name of the device in the topology.",
              "examples": [
                "ADServer"
              ],
              "type": "string"
            },
            "vm_type": {
              "default": "vm",
              "description": "Whether the device is a virtual machine or a container.",
              "enum": [
                "vm",
                "container",
                ""
              ],
              "examples": [
                "vm"
              ],
              "type": "string"
            }
          },
          "required": [
            "hostname"
          ],
          "type": "object"
        },
        "hardware": {
          "properties": {
            "cpu": {
              "default": "Broadwell",
              "description": "CPU model of the device.",
              "examples": [
                "Broadwell"
              ],
              "type": "string"
            },
            "memory": {
              "default": 512,
              "description": "Memory of the device, in megabytes.",
              "examples": [
                8192
              ],
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "os_type": {
              "default": "linux",
              "description": "Operating system of the device.",
              "enum": [
                "centos",
                "linux",
                "minirouter",
                "rhel",
                "vyatta",
                "vyos",
                "windows",
                "other"
              ],
              "examples": [
                "windows"
              ],
              "type": "string"
            },
            "vcpus": {
              "default": 1,
              "description": "Number of CPUs of the device.",
              "examples": [
                4
              ],
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "os_type"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "network": {
          "properties": {
            "interfaces": {
              "description": "Network interfaces of the device, for the topology's network diagram and State of Health checks.",
              "items": {
                "properties": {
                  "address": {
                    "description": "IPv4 address of the interface.",
                    "examples": [
                      "192.168.1.100"
                    ],
                    "type": "string"
                  },
                  "gateway": {
                    "description": "Default gateway of the interface.",
                    "examples": [
                      "192.168.1.1"
                    ],
                    "type": "string"
                  },
                  "mask": {
                    "default": 24,
                    "description": "Network prefix length (CIDR bits), from 0 to 32.",
                    "examples": [
                      24
                    ],
                    "maximum": 32,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "name": {
                    "description": "Interface name, such as eth0.",
                    "examples": [
                      "eth0"
                    ],
                    "type": "string"
                  },
                  "proto": {
                    "default": "dhcp",
                    "description": "How the interface gets its address: static, dhcp, or manual for none.",
                    "enum": [
                      "static",
                      "dhcp",
                      "manual",
                      ""
                    ],
                    "examples": [
                      "static"
                    ],
                    "type": "string"
                  },
                  "vlan": {
                    "description": "VLAN (network) the interface is on.",
                    "examples": [
                      "EXP-1"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "interfaces"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "type": {
          "default": "HIL",
          "description": "What the device is, such as HIL for hardware in the loop.",
          "examples": [
            "HIL"
          ],
          "type": "string"
        }
      },
      "required": [
        "external",
        "type",
        "general"
      ],
      "type": "object"
    },
    "iface": {
      "properties": {
        "autostart": {
          "default": true,
          "description": "Whether the interface should come up when the VM boots. phenix itself does not act on this setting.",
          "type": "boolean"
        },
        "bridge": {
          "default": "phenix",
          "description": "Open vSwitch bridge on the host the interface attaches to. Empty or phenix uses the experiment's default bridge.",
          "type": "string"
        },
        "driver": {
          "description": "Emulated network card, such as e1000 or virtio-net-pci. Empty uses minimega's default.",
          "examples": [
            "e1000"
          ],
          "type": "string"
        },
        "mac": {
          "description": "MAC address. minimega generates one when it is empty.",
          "examples": [
            "00:11:22:33:44:55"
          ],
          "pattern": "^$|^([0-9a-fA-F]{2}[:-]){5}([0-9a-fA-F]){2}$",
          "type": "string"
        },
        "mtu": {
          "default": 1500,
          "description": "Maximum transmission unit, in bytes. Vyatta and VyOS routers apply values from 68 to 16000; other images keep their own.",
          "examples": [
            1500
          ],
          "type": "integer"
        },
        "name": {
          "description": "Interface name, such as eth0, which NAT settings and apps use to refer to it.",
          "examples": [
            "eth0"
          ],
          "type": "string"
        },
        "qinq": {
          "default": false,
          "description": "Carry the guest's own VLAN tags inside the interface's VLAN (QinQ, 802.1ad). The guest brings the interface up without an address.",
          "type": "boolean"
        },
        "vlan": {
          "description": "VLAN (network) the interface is on.",
          "examples": [
            "EXP-1"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "vlan"
      ],
      "type": "object"
    },
    "iface_address": {
      "properties": {
        "address": {
          "description": "IPv4 address of the interface.",
          "examples": [
            "192.168.1.100"
          ],
          "type": "string"
        },
        "dns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "description": "DNS server addresses the guest uses: one address, or a list.",
              "examples": [
                [
                  "192.168.1.1",
                  "192.168.1.2"
                ]
              ],
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            }
          ],
          "description": "DNS server addresses the guest uses: one address, or a list."
        },
        "gateway": {
          "description": "Default gateway, reached through this interface.",
          "examples": [
            "192.168.1.1"
          ],
          "type": "string"
        },
        "mask": {
          "default": 24,
          "description": "Network prefix length (CIDR bits), from 0 to 32.",
          "examples": [
            24
          ],
          "maximum": 32,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "mask"
      ],
      "type": "object"
    },
    "iface_rulesets": {
      "properties": {
        "ruleset_in": {
          "description": "Ruleset for traffic coming in on this interface, on Router and Firewall nodes.",
          "examples": [
            "InFromInet"
          ],
          "pattern": "^[\\w-]*$",
          "type": "string"
        },
        "ruleset_out": {
          "description": "Ruleset for traffic going out of this interface, on Router and Firewall nodes.",
          "examples": [
            "OutToInet"
          ],
          "pattern": "^[\\w-]*$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "minimega_node": {
      "properties": {
        "advanced": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Extra minimega vm config settings, each a setting name and its value.",
          "type": [
            "object",
            "null"
          ]
        },
        "commands": {
          "description": "minimega command and control (cc) commands phenix sends to the VM, such as exec df -h.",
          "examples": [
            [
              "exec df -h"
            ]
          ],
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "delay": {
          "properties": {
            "c2": {
              "description": "Start the VM once each of these hosts has checked in with minimega command and control.",
              "items": {
                "properties": {
                  "hostname": {
                    "description": "Host to wait for.",
                    "type": "string"
                  },
                  "useUUID": {
                    "description": "Wait for the host's UUID, rather than its hostname, to check in.",
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "timer": {
              "description": "Start the VM this long after the experiment starts, as a duration such as 30s or 5m.",
              "examples": [
                "5m"
              ],
              "type": "string"
            },
            "user": {
              "description": "Leave the VM stopped until someone starts it from phenix or minimega. Takes precedence over the other delays.",
              "type": "boolean"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "general": {
          "properties": {
            "description": {
              "description": "Free-text notes about the node.",
              "examples": [
                "Active Directory Server"
              ],
              "type": "string"
            },
            "do_not_boot": {
              "default": false,
              "description": "Leave the node out when the experiment starts: phenix neither creates nor starts its VM. phenix also sets this when the first drive's image is missing.",
              "examples": [
                false
              ],
              "type": [
                "boolean",
                "null"
              ]
            },
            "hostname": {
              "description": "Name of the VM in minimega and the host name set in the guest. Unique in the topology.",
              "examples": [
                "ADServer"
              ],
              "maxLength": 63,
              "minLength": 2,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]*[a-zA-Z0-9]$",
              "type": "string"
            },
            "snapshot": {
              "default": true,
              "description": "Run the VM on a copy-on-write snapshot of its first drive, which phenix creates for the experiment and injects files into, so the image file itself does not change. phenix turns this on when it is not set.",
              "examples": [
                true
              ],
              "type": [
                "boolean",
                "null"
              ]
            },
            "vm_type": {
              "default": "kvm",
              "description": "How minimega runs the node: kvm for a QEMU/KVM virtual machine, or container. Empty means kvm.",
              "enum": [
                "kvm",
                "container",
                ""
              ],
              "examples": [
                "kvm"
              ],
              "type": "string"
            }
          },
          "required": [
            "hostname"
          ],
          "type": "object"
        },
        "hardware": {
          "properties": {
            "cpu": {
              "default": "Broadwell",
              "description": "QEMU CPU model for the VM, such as Broadwell or host.",
              "examples": [
                "Broadwell"
              ],
              "type": "string"
            },
            "drives": {
              "description": "Disks attached to the VM, in order. The first is the one phenix snapshots and injects files into.",
              "items": {
                "properties": {
                  "cache_mode": {
                    "default": "writeback",
                    "description": "QEMU cache mode for the disk. Empty uses writeback for a snapshot, and QEMU's default otherwise.",
                    "enum": [
                      "none",
                      "writeback",
                      "unsafe",
                      "directsync",
                      "writethrough",
                      ""
                    ],
                    "examples": [
                      "writeback"
                    ],
                    "type": "string"
                  },
                  "image": {
                    "description": "Disk image file: a name in the phenix image directory, or an absolute path on the host.",
                    "examples": [
                      "ubuntu.qc2"
                    ],
                    "minLength": 1,
                    "type": "string"
                  },
                  "inject_partition": {
                    "default": 1,
                    "description": "Partition of the first drive that phenix injects files into. 0 skips disk injection, and phenix sends its startup scripts through minimega command and control instead. phenix uses 1 when it is not set.",
                    "examples": [
                      2
                    ],
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "interface": {
                    "default": "ide",
                    "description": "Bus the disk is attached to, such as ide, scsi or virtio. Empty uses minimega's default.",
                    "enum": [
                      "ahci",
                      "ide",
                      "scsi",
                      "sd",
                      "mtd",
                      "floppy",
                      "pflash",
                      "virtio",
                      ""
                    ],
                    "examples": [
                      "ide"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "image"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "memory": {
              "default": 512,
              "description": "Memory for the VM, in megabytes. phenix uses 512 when it is not set.",
              "examples": [
                8192
              ],
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "os_type": {
              "default": "linux",
              "description": "Operating system in the disk image. phenix and its apps choose startup scripts and router configuration by it.",
