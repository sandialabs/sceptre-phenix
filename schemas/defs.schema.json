{
  "$defs": {
    "Experiment": {
      "properties": {
        "baseDir": {
          "examples": [
            "/phenix/topologies/example-topo"
          ],
          "type": "string"
        },
        "experimentName": {
          "examples": [
            "example-exp"
          ],
          "readOnly": true,
          "type": "string"
        },
        "scenario": {
          "$ref": "#/$defs/Scenario"
        },
        "schedule": {
          "additionalProperties": {
            "type": "string"
          },
          "examples": [
            {
              "ADServer": "compute1"
            }
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "topology": {
          "$ref": "#/$defs/Topology"
        },
        "vlans": {
          "properties": {
            "aliases": {
              "additionalProperties": {
                "type": "integer"
              },
              "examples": [
                {
                  "MGMT": 200
                }
              ],
              "type": [
                "object",
                "null"
              ]
            },
            "max": {
              "type": "integer"
            },
            "min": {
              "type": "integer"
            }
          },
          "type": [
            "object",
            "null"
          ]
        }
      },
      "required": [
        "topology"
      ],
      "type": "object"
    },
    "Image": {
      "properties": {
        "compress": {
          "default": false,
          "examples": [
            false
          ],
          "type": "boolean"
        },
        "deb_append": {
          "examples": [
            "--components=main,restricted"
          ],
          "type": "string"
        },
        "format": {
          "examples": [
            "qcow2"
          ],
          "type": "string"
        },
        "mirror": {
          "examples": [
            "http://us.archive.ubuntu.com/ubuntu/"
          ],
          "type": "string"
        },
        "overlays": {
          "examples": [
            [
              "/phenix/vmdb/overlays/example-overlay"
            ]
          ],
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "packages": {
          "examples": [
            [
              "isc-dhcp-client",
              "openssh-server"
            ]
          ],
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "ramdisk": {
          "default": false,
          "examples": [
            false
          ],
          "type": "boolean"
        },
        "release": {
          "examples": [
            "focal"
          ],
          "type": "string"
        },
        "script_order": {
          "examples": [
            [
              "POSTBUILD_APT_CLEANUP"
            ]
          ],
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "scripts": {
          "additionalProperties": {
            "type": "string"
          },
          "examples": [
            {
              "POSTBUILD_APT_CLEANUP": "apt clean || apt-get clean || echo \"unable to clean apt cache\"\n"
            }
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "size": {
          "examples": [
            "10G"
          ],
          "type": "string"
        },
        "variant": {
          "examples": [
            "minbase"
          ],
          "type": "string"
        }
      },
      "required": [
        "format",
        "mirror",
        "release",
        "size",
        "variant"
      ],
      "type": "object"
    },
    "Role": {
      "properties": {
        "policies": {
          "examples": [
            [
              {
                "resourceNames": [
                  "*"
                ],
                "resources": [
                  "experiments",
                  "experiments/*"
                ],
                "verbs": [
                  "list",
                  "get"
                ]
              }
            ]
          ],
          "items": {
            "properties": {
              "resourceNames": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "resources": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "verbs": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "type": "object"
          },
          "type": "array"
        },
        "roleName": {
          "examples": [
            "Example Role"
          ],
          "type": "string"
        }
      },
      "required": [
        "policies",
        "roleName"
      ],
      "type": "object"
    },
    "Scenario": {
      "properties": {
        "apps": {
          "items": {
            "properties": {
              "assetDir": {
                "examples": [
                  "/phenix/topologies/example-topo/assets"
                ],
                "type": "string"
              },
              "disabled": {
                "default": false,
                "examples": [
                  false
                ],
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "hosts": {
                "items": {
                  "properties": {
                    "hostname": {
                      "examples": [
                        "example-host"
                      ],
                      "type": "string"
                    },
                    "metadata": {
                      "additionalProperties": true,
                      "examples": [
                        {
                          "setting0": true,
                          "setting1": 42,
                          "setting2": "universe key"
                        }
                      ],
                      "type": [
                        "object",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "hostname"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "metadata": {
                "additionalProperties": true,
                "examples": [
                  {
                    "setting0": true,
                    "setting1": 42,
                    "setting2": "universe key"
                  }
                ],
                "type": [
                  "object",
                  "null"
                ]
              },
              "name": {
                "examples": [
                  "example-app"
                ],
                "type": "string"
              }
            },
            "required": [
              "name"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "required": [
        "apps"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "Topology": {
      "properties": {
        "nodes": {
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/minimega_node"
              },
              {
                "$ref": "#/$defs/external_node"
              }
            ]
          },
          "type": "array"
        }
      },
      "required": [
        "nodes"
      ],
      "type": "object"
    },
    "User": {
      "properties": {
        "first_name": {
          "examples": [
            "John"
          ],
          "type": "string"
        },
        "last_name": {
          "examples": [
            "Doe"
          ],
          "type": "string"
        },
        "password": {
          "examples": [
            "\u003cencrypted password\u003e"
          ],
          "readOnly": true,
          "type": "string"
        },
        "rbac": {
          "allOf": [
            {
              "$ref": "#/$defs/Role"
            }
          ],
          "readOnly": true
        },
        "username": {
          "examples": [
            "johndoe@example.com"
          ],
          "type": "string"
        }
      },
      "required": [
        "first_name",
        "last_name",
        "username"
      ],
      "type": "object"
    },
    "dhcp_iface": {
      "allOf": [
        {
          "$ref": "#/$defs/iface"
        },
        {
          "$ref": "#/$defs/iface_rulesets"
        }
      ],
      "properties": {
        "proto": {
          "default": "dhcp",
          "enum": [
            "dhcp",
            "manual"
          ],
          "examples": [
            "dhcp"
          ],
          "type": "string"
        },
        "type": {
          "default": "ethernet",
          "enum": [
            "ethernet"
          ],
          "examples": [
            "ethernet"
          ],
          "type": "string"
        }
      },
      "required": [
        "type",
        "proto"
      ],
      "type": "object"
    },
    "external_node": {
      "properties": {
        "external": {
          "type": "boolean"
        },
        "general": {
          "properties": {
            "description": {
              "examples": [
                "Active Directory Server"
              ],
              "type": "string"
            },
            "hostname": {
              "examples": [
                "ADServer"
              ],
              "type": "string"
            },
            "vm_type": {
              "default": "vm",
              "enum": [
                "vm",
                "container",
                ""
              ],
              "examples": [
                "vm"
              ],
              "type": "string"
            }
          },
          "required": [
            "hostname"
          ],
          "type": "object"
        },
        "hardware": {
          "properties": {
            "cpu": {
              "default": "Broadwell",
              "examples": [
                "Broadwell"
              ],
              "type": "string"
            },
            "memory": {
              "default": 1024,
              "examples": [
                8192
              ],
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "os_type": {
              "default": "linux",
              "enum": [
                "centos",
                "linux",
                "minirouter",
                "rhel",
                "vyatta",
                "vyos",
                "windows",
                "other"
              ],
              "examples": [
                "windows"
              ],
              "type": "string"
            },
            "vcpus": {
              "default": 1,
              "examples": [
                4
              ],
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "os_type"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "network": {
          "properties": {
            "interfaces": {
              "items": {
                "properties": {
                  "address": {
                    "examples": [
                      "192.168.1.100"
                    ],
                    "type": "string"
                  },
                  "gateway": {
                    "examples": [
                      "192.168.1.1"
                    ],
                    "type": "string"
                  },
                  "mask": {
                    "default": 24,
                    "examples": [
                      24
                    ],
                    "maximum": 32,
                    "minimum": 0,
                    "type": "integer"
                  },
                  "name": {
                    "examples": [
                      "eth0"
                    ],
                    "type": "string"
                  },
                  "proto": {
                    "default": "dhcp",
                    "enum": [
                      "static",
                      "dhcp",
                      "manual",
                      ""
                    ],
                    "examples": [
                      "static"
                    ],
                    "type": "string"
                  },
                  "vlan": {
                    "examples": [
                      "EXP-1"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "name"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "required": [
            "interfaces"
          ],
          "type": [
            "object",
            "null"
          ]
        },
        "type": {
          "default": "HIL",
          "examples": [
            "HIL"
          ],
          "type": "string"
        }
      },
      "required": [
        "external",
        "type",
        "general"
      ],
      "type": "object"
    },
    "iface": {
      "properties": {
        "autostart": {
          "default": true,
          "type": "boolean"
        },
        "bridge": {
          "default": "phenix",
          "type": "string"
        },
        "driver": {
          "examples": [
            "e1000"
          ],
          "type": "string"
        },
        "mac": {
          "examples": [
            "00:11:22:33:44:55"
          ],
          "pattern": "^$|^([0-9a-fA-F]{2}[:-]){5}([0-9a-fA-F]){2}$",
          "type": "string"
        },
        "mtu": {
          "default": 1500,
          "examples": [
            1500
          ],
          "type": "integer"
        },
        "name": {
          "examples": [
            "eth0"
          ],
          "type": "string"
        },
        "qinq": {
          "default": false,
          "type": "boolean"
        },
        "vlan": {
          "examples": [
            "EXP-1"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "vlan"
      ],
      "type": "object"
    },
    "iface_address": {
      "properties": {
        "address": {
          "examples": [
            "192.168.1.100"
          ],
          "type": "string"
        },
        "dns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "examples": [
                [
                  "192.168.1.1",
                  "192.168.1.2"
                ]
              ],
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                }
              ]
            }
          ]
        },
        "gateway": {
          "examples": [
            "192.168.1.1"
          ],
          "type": "string"
        },
        "mask": {
          "default": 24,
          "examples": [
            24
          ],
          "maximum": 32,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "address",
        "mask"
      ],
      "type": "object"
    },
    "iface_rulesets": {
      "properties": {
        "ruleset_in": {
          "examples": [
            "InFromInet"
          ],
          "pattern": "^[\\w-]*$",
          "type": "string"
        },
        "ruleset_out": {
          "examples": [
            "OutToInet"
          ],
          "pattern": "^[\\w-]*$",
          "type": "string"
        }
      },
      "type": "object"
    },
    "minimega_node": {
      "properties": {
        "advanced": {
          "additionalProperties": {
            "type": "string"
          },
          "type": [
            "object",
            "null"
          ]
        },
        "commands": {
          "examples": [
            [
              "exec df -h"
            ]
          ],
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "delay": {
          "properties": {
            "c2": {
              "items": {
                "properties": {
                  "hostname": {
                    "type": "string"
                  },
                  "useUUID": {
                    "type": "boolean"
                  }
                },
                "type": "object"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "timer": {
              "examples": [
                "5m"
              ],
              "type": "string"
            },
            "user": {
              "type": "boolean"
            }
          },
          "type": [
            "object",
            "null"
          ]
        },
        "general": {
          "properties": {
            "description": {
              "examples": [
                "Active Directory Server"
              ],
              "type": "string"
            },
            "do_not_boot": {
              "default": false,
              "examples": [
                false
              ],
              "type": [
                "boolean",
                "null"
              ]
            },
            "hostname": {
              "examples": [
                "ADServer"
              ],
              "maxLength": 63,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]*[a-zA-Z0-9])?$",
              "type": "string"
            },
            "snapshot": {
              "default": false,
              "examples": [
                false
              ],
              "type": [
                "boolean",
                "null"
              ]
            },
            "vm_type": {
              "default": "kvm",
              "enum": [
                "kvm",
                "container",
                ""
              ],
              "examples": [
                "kvm"
              ],
              "type": "string"
            }
          },
          "required": [
            "hostname"
          ],
          "type": "object"
        },
        "hardware": {
          "properties": {
            "cpu": {
              "default": "Broadwell",
              "examples": [
                "Broadwell"
              ],
              "type": "string"
            },
            "drives": {
              "items": {
                "properties": {
                  "cache_mode": {
                    "default": "writeback",
                    "enum": [
                      "none",
                      "writeback",
                      "unsafe",
                      "directsync",
                      "writethrough",
                      ""
                    ],
                    "examples": [
                      "writeback"
                    ],
                    "type": "string"
                  },
                  "image": {
                    "examples": [
                      "ubuntu.qc2"
                    ],
                    "minLength": 1,
                    "type": "string"
                  },
                  "inject_partition": {
                    "default": 1,
                    "examples": [
                      2
                    ],
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "interface": {
                    "default": "ide",
                    "enum": [
                      "ahci",
                      "ide",
                      "scsi",
                      "sd",
                      "mtd",
                      "floppy",
                      "pflash",
                      "virtio",
                      ""
                    ],
                    "examples": [
                      "ide"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "image"
                ],
                "type": "object"
              },
              "minItems": 1,
              "type": "array"
            },
            "memory": {
              "default": 1024,
              "examples": [
                8192
              ],
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            },
            "os_type": {
              "default": "linux",
              "enum": [
                "centos",
                "linux",
                "minirouter",
                "rhel",
                "vyatta",
                "vyos",
                "windows",
                "other"
              ],
              "examples": [
                "windows"
              ],
              "type": "string"
            },
            "vcpus": {
              "default": 1,
              "examples": [
                4
              ],
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "string"
                }
              ]
            }
          },
          "required": [
            "os_type",
            "drives"
          ],
          "type": "object"
        },
        "injections": {
          "items": {
            "properties": {
              "description": {
                "examples": [
                  "phenix config file"
                ],
                "type": "string"
              },
              "dst": {
                "examples": [
                  "/etc/phenix/foo.xml"
                ],
                "type": "string"
              },
              "permissions": {
                "examples": [
                  "0664"
                ],
                "type": "string"
              },
              "src": {
                "examples": [
                  "foo.xml"
                ],
                "type": "string"
              }
            },
            "required": [
              "src",
              "dst"
            ],
            "type": "object"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "network": {
          "properties": {
            "interfaces": {
              "items": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/static_iface"
                  },
                  {
                    "$ref": "#/$defs/dhcp_iface"
                  },
                  {
                    "$ref": "#/$defs/serial_iface"
                  }
                ],
                "type": "object"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "ospf": {
              "properties": {
                "areas": {
                  "items": {
                    "properties": {
                      "area_id": {
                        "default": 1,
                        "examples": [
                          1
                        ],
                        "type": "integer"
                      },
                      "area_networks": {
                        "items": {
                          "properties": {
                            "network": {
                              "examples": [
                                "10.1.25.0/24"
                              ],
                              "type": "string"
                            }
                          },
                          "required": [
                            "network"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      }
                    },
                    "required": [
                      "area_id",
                      "area_networks"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "dead_interval": {
                  "examples": [
                    40
                  ],
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "hello_interval": {
                  "examples": [
                    10
                  ],
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "retransmission_interval": {
                  "examples": [
                    5
                  ],
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "router_id": {
                  "examples": [
                    "0.0.0.1"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "router_id",
                "areas"
              ],
              "type": [
                "object",
                "null"
              ]
            },
            "routes": {
              "items": {
                "properties": {
                  "cost": {
                    "default": 1,
                    "examples": [
                      1
                    ],
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "destination": {
                    "examples": [
                      "192.168.0.0/24"
                    ],
                    "type": "string"
                  },
                  "next": {
                    "examples": [
                      "192.168.1.254"
                    ],
                    "type": "string"
                  }
                },
                "required": [
                  "destination",
                  "next"
                ],
                "type": "object"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "rulesets": {
              "items": {
                "properties": {
                  "default": {
                    "enum": [
                      "accept",
                      "drop",
                      "reject"
                    ],
                    "examples": [
                      "drop"
                    ],
                    "type": "string"
                  },
                  "description": {
                    "examples": [
                      "From Corp to the DMZ network"
                    ],
                    "type": "string"
                  },
                  "name": {
                    "examples": [
                      "OutToDMZ"
                    ],
                    "type": "string"
                  },
                  "rules": {
                    "items": {
                      "properties": {
                        "action": {
                          "enum": [
                            "accept",
                            "drop",
                            "reject"
                          ],
                          "examples": [
                            "accept"
                          ],
                          "type": "string"
                        },
                        "description": {
                          "examples": [
                            "Allow UDP 10.1.26.80 ==\u003e 10.2.25.0/24:123"
                          ],
                          "type": "string"
                        },
                        "destination": {
                          "properties": {
                            "address": {
                              "examples": [
                                "10.1.24.60"
                              ],
                              "type": "string"
                            },
                            "port": {
                              "examples": [
                                3389
                              ],
                              "type": "integer"
                            }
                          },
                          "required": [
                            "address"
                          ],
                          "type": [
                            "object",
                            "null"
                          ]
                        },
                        "id": {
                          "examples": [
