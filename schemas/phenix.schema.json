{
  "$id": "https://raw.githubusercontent.com/sandialabs/sceptre-phenix/main/schemas/phenix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Any phenix config file, checked against the schema of its kind. A document whose apiVersion is not in the phenix.sandia.gov API group is not checked. Generated by src/go/tools/schema-export from the embedded OpenAPI schemas; do not edit.",
  "if": {
    "properties": {
      "apiVersion": {
        "pattern": "^phenix\\.sandia\\.gov/",
        "type": "string"
      }
    },
    "required": [
      "apiVersion"
    ],
    "type": "object"
  },
  "then": {
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "const": "User"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "then": {
          "$ref": "user.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "Role"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "then": {
          "$ref": "role.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "Image"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "then": {
          "$ref": "image.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "Topology"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "then": {
          "$ref": "topology.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "Scenario"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "then": {
          "$ref": "scenario.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "Experiment"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "then": {
          "$ref": "experiment.schema.json"
        }
      },
      {
        "if": {
          "properties": {
            "kind": {
              "const": "Workflow"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        "then": {
          "$ref": "workflow.schema.json"
        }
      }
    ],
    "properties": {
      "kind": {
        "enum": [
          "User",
          "Role",
          "Image",
          "Topology",
          "Scenario",
          "Experiment",
          "Workflow"
        ]
      }
    },
    "required": [
      "kind"
    ],
    "type": "object"
  },
  "title": "phenix config"
}
