          },
          "labels": {
            "zone": "ot"
          },
          "network": {
            "interfaces": [
              {
                "address": "10.10.20.254",
                "gateway": "10.10.20.1",
                "mask": 24,
                "name": "eth0",
                "proto": "static",
                "ruleset_in": "corp-to-ot",
                "type": "ethernet",
                "vlan": "CORP"
              },
              {
                "address": "10.10.30.1",
                "mask": 24,
                "name": "eth1",
                "proto": "static",
                "type": "ethernet",
                "vlan": "OT"
              }
            ],
            "rulesets": [
              {
                "default": "drop",
                "description": "Only the historian's web interface is reachable from CORP",
                "name": "corp-to-ot",
                "rules": [
                  {
                    "action": "accept",
                    "description": "HTTPS to the historian",
                    "destination": {
                      "address": "10.10.30.20",
                      "port": 443
                    },
                    "id": 10,
                    "protocol": "tcp",
                    "source": {
                      "address": "10.10.20.0/24"
                    }
                  }
                ]
              }
            ]
          },
          "type": "Firewall"
        },
